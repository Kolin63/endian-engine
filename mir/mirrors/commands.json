{
  "id": "commands",
  "files": [
    {
      "name": "commands.h",
      "format": [
        "#ifndef ENDIAN_COMMANDS_H_",
        "#define ENDIAN_COMMANDS_H_",
        "",
        "__PREPROC__",
        "",
        "#include \"../src/command.h\"",
        "",


        "enum command_id {",
        "  COMMAND_UNKNOWN_,",
        {
          "tag": "command",
          "format": [
            "  COMMAND_%D,  // %B"
          ]
        },
        "};",
        "",
        "const static struct command commands[] = {",
        "",
        {
          "tag": "command",
          "format": [
            "// %B",
            "[COMMAND_%D] = %t,"
          ]
        },
        "};",
        "",
        "#endif"
      ]
    },




    {
      "name": "commands.c",
      "format": [
        "#include \"commands.h\"",
        "",
        "#include <pthread.h>",
        "",
        "#include \"endapi/get_command_options.h\"",
        "#include \"endapi/owners.h\"",
        "",
        "static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;",
        "",
        {
          "tag": "command_cb",
          "format": [
            "// %B",
            "static void",
            "%d_cb(struct discord* client, const struct discord_interaction* event) {%t}"
          ]
        },
        "enum command_id",
        "command_id_get(const char* str) {",
        {
          "tag": "command",
          "format": [
            "%Astr",
            "%A%d",
            "%Areturn COMMAND_%D;  // %B",
            "%Areturn COMMAND_UNKNOWN_;",
            "%A"
          ]
        },
        "}",
        "",
        "void",
        "command_cb(enum command_id id, struct discord* client, const struct discord_interaction* event) {",
        "  if (id == COMMAND_UNKNOWN_) {",
        "    log_error(\"Unknown command\");",
        "    command_basic_response(client, event, true, \"Unknown command\");",
        "    return;",
        "  }",
        "  ",
        "  pthread_mutex_lock(&lock);",
        "  ",
        "  switch (id) {",
        {
          "tag": "command_cb",
          "format": [
            "  case COMMAND_%D:  // %B",
            "    if (commands[id].owner_only && !is_owner(command_event_get_uuid(event))) {  // %B",
            "      command_basic_response(client, event, true, \"You are not an owner!\");  // %B",
            "      break;  // %B",
            "    }  // %B",
            "    %d_cb(client, event);  // %B",
            "    break;  // %B"
          ]
        },
        "  default:",
        "    log_error(\"Unknown command %%i\", id);",
        "    command_basic_response(client, event, true, \"Unknown command\");",
        "    break;",
        "  }",
        "  ",
        "  pthread_mutex_unlock(&lock);",
        "}",
        "",
        "void",
        "command_create_all(const struct discord_ready* event) {",
        {
          "tag": "command",
          "format": [
            "  command_create(&commands[COMMAND_%D], event);  // %B"
          ]
        },
        "}"
      ]
    }
  ]
}
